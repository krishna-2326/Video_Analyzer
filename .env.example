# Mistral AI API Key (Get your key from https://console.mistral.ai/)
MISTRAL_API_KEY=your_mistral_api_key_here

# Sarvam AI API Key for Hinglish / Hindi translation (Optional)
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v2.5

# Whisper Model Size (tiny, base, small, medium, large - "base" recommended for CPU)
WHISPER_MODEL=base

# YouTube Cookie File Path (Optional, for restricted videos)
# YTDLP_COOKIE_FILE=cookies.txt
